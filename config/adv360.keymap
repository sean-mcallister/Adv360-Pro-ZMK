#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"
      #ifndef VERSION_MACRO

        macro_ver: macro_ver {
            compatible = "zmk,behavior-macro";
            label = "macro_version";
            #binding-cells = <0>;
            bindings = <&kp RET>;
        };

        tmuxwin: workspace {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&kp LC(A) &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "WORKSPACE";
        };

        #endif

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <233>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        kpmo: kpmo {
            compatible = "zmk,behavior-hold-tap";
            label = "KPMO";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick_tap_ms = <175>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <75 45 59 7 8 9 10 11 12 13 21 22 23 24 25 26 27 39 40 41 42 43 44 45 54 55 56 57 58 59 71 72 73 74 36 37 38 52 53 68 69 70 71 72 35 36 37 38 52 53 65 66 67 68 69 70>;
            hold-trigger-on-release;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick_tap_ms = <175>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <36 37 38 52 53 68 69 70 0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 60 61 62 63 64 65 66 67>;
        };
    };

    macros {
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp EXCLAMATION  &kp PLUS         &kp LEFT_BRACKET      &kp LEFT_BRACE                 &kp LEFT_PARENTHESIS  &kp AMPERSAND  &tog 3                                                                     &mo 0          &kp EQUAL  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE               &kp RIGHT_BRACKET       &kp ASTERISK         &kp MINUS
&kp GRAVE        &kp Q            &kp W                 &kp E                          &kp R                 &kp T          &none                                                                      &none          &kp Y      &kp U                  &kp I                         &kp O                   &kp P                &kp BSLH
&kp TAB          &hml LEFT_GUI A  &hml LALT S           &hml LCTRL D                   &hml LSHIFT F         &kp G          &none              &kp LCTRL       &kp LALT      &kp LGUI   &kp RCTRL      &none          &kp H      &hmr RSHIFT J          &hmr RCTRL K                  &hmr RIGHT_ALT L        &hmr RIGHT_GUI SEMI  &kp SQT
&kpmo 5 TILDE    &kp Z            &hml LA(LC(LSHFT)) X  &hml LA(LC(LG(LEFT_SHIFT))) C  &kp V                 &kp B                                             &kp HOME      &kp PG_UP                                &kp N      &kp M                  &hmr RA(RC(RG(RSHFT))) COMMA  &hmr RA(RC(RSHFT)) DOT  &kp FSLH             &kp DOLLAR
&mo 1            &none            &none                 &kp LEFT                       &kp RIGHT                            &kpmo 1 BACKSPACE  &kpmo 2 ESCAPE  &kp END       &kp PG_DN  &kpmo 4 ENTER  &kpmo 3 SPACE             &kp UP                 &kp DOWN                      &none                   &none                &mo 1
            >;
        };

        sym {
            bindings = <
&none  &none         &none              &none            &none                  &none          &tog 3                                    &mo 0   &none       &none      &none           &none                 &none        &none
&none  &kp CARET     &kp SEMICOLON      &kp COLON        &kp EXCLAMATION        &kp AMPERSAND  &trans                                    &trans  &kp HASH    &kp GRAVE  &kp MINUS       &kp PLUS              &kp AT_SIGN  &none
&none  &kp ASTERISK  &kp LEFT_BRACKET   &kp LEFT_BRACE   &kp LEFT_PARENTHESIS   &kp EQUAL      &trans  &none   &none      &none  &none   &trans  &kp DOLLAR  &sk LSHFT  &sk LCTRL       &sk LEFT_ALT          &sk LCMD     &none
&none  &kp PERCENT   &kp RIGHT_BRACKET  &kp RIGHT_BRACE  &kp RIGHT_PARENTHESIS  &kp PIPE                       &none      &none                  &kp SLASH   &kp TILDE  &kp UNDERSCORE  &kp NON_US_BACKSLASH  &none        &none
&none  &none         &none              &none            &none                                 &trans  &trans  &none      &none  &trans  &trans              &none      &none           &none                 &none        &none
            >;
        };

        kp {
            bindings = <
&none  &none         &kp C_PREVIOUS     &kp C_PP               &kp C_NEXT  &none  &trans                                     &trans  &none         &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &none         &none
&none  &kp N1        &kp N2             &kp N3                 &kp N4      &kp N5 &trans                                     &trans  &kp N6        &kp N7      &kp N8        &kp N9        &kp N0        &none
&none  &sk LEFT_GUI  &sk LEFT_ALT       &sk LCTRL              &sk LSHFT   &none  &trans  &none   &none      &none  &none    &trans  &kp H         &kp J       &kp K         &kp L         &none         &none
&none  &none         &kp LA(LC(LSHFT))  &kp LA(LC(LG(LSHFT)))  &none       &none                  &none      &none                   &kp CARET     &kp LS(G)   &kp G         &kp DOLLAR    &none         &none
&none  &none         &none              &none                  &none              &trans  &trans  &none      &none  &trans   &trans                &none       &none         &none         &none         &none
            >;
        };

        ses {
            bindings = <
&none  &kp LA(N0)          &kp LA(N9)          &kp LA(N8)          &kp LA(N7)          &kp LA(N6)  &trans                                    &trans  &none     &none      &none      &none      &none  &none
&none  &kp LA(N5)          &kp LA(N4)          &kp LA(N3)          &kp LA(N2)          &kp LA(N1)  &trans                                    &trans  &none     &none      &none      &none      &none  &none
&none  &sk LGUI            &sk LALT            &sk LCTRL           &sk LSHFT           &none       &trans  &none   &none      &none  &none   &trans  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &none  &none
&none  &kp LS(LA(LC(F2)))  &kp LA(LC(LS(F3)))  &kp LS(LA(LC(F4)))  &kp LS(LA(LC(F1)))  &caps_word                  &none      &none                  &kp HOME  &kp PG_UP  &kp PG_DN  &kp END    &none  &none
&none  &none               &none               &none               &none                           &trans  &trans  &none      &none  &trans  &trans            &none      &none      &none      &none  &none
            >;
        };

        util {
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1   &bt BT_SEL 2  &bt BT_SEL 3   &bt BT_SEL 4   &none                                                    &trans                  &none                     &none          &none          &none          &none       &none
&none  &none         &none          &none         &none          &none          &bootloader                                              &bootloader             &none                     &none          &none          &none          &none       &none
&none  &kp LC(N0)    &kp LC(MINUS)  &kp LC(PLUS)  &kp LG(SPACE)  &kp LG(LS(S))  &none        &none   &none      &bt BT_CLR       &none   &rgb_ug RGB_MEFS_CMD 5  &kp LS(LC(LG(NUMBER_4)))  &none          &kp LG(PLUS)   &kp LG(MINUS)  &kp LG(N0)  &none
&none  &none         &none          &none         &macro_ver     &none                               &none      &bl BL_TOG                                       &kp LG(DOT)               &kp LG(LS(A))  &kp LS(LG(M))  &kp LG(LS(T))  &none       &none
&none  &none         &none          &none         &none                         &trans       &trans  &none      &rgb_ug RGB_TOG  &trans  &trans                                            &bl BL_INC     &bl BL_DEC     &none          &none       &none
            >;
        };

        fn {
            bindings = <
&none   &none  &none  &none  &none  &none  &trans                                    &trans  &none  &none   &none   &none   &none    &none
&none   &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &trans                                    &trans  &kp F6 &kp F7  &kp F8  &kp F9  &kp F10  &none
&none  &sk LEFT_GUI  &sk LEFT_ALT       &sk LCTRL              &sk LSHFT   &none  &trans  &none   &none      &none  &none    &trans  &kp H         &kp J       &kp K         &kp L         &none         &none
&trans  &none  &none  &none  &none  &none                  &none      &none                  &none  &kp F1  &kp F2  &kp F3  &kp F12  &none
&none   &none  &none  &none  &none         &trans  &trans  &none      &none  &trans  &trans         &none   &none   &none   &none    &none
            >;
        };
    };
};
